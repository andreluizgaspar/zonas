	},
	"item": [
		{
			"name": "Autenticação",
			"item": [
				{
					"name": "Registrar Usuário",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Usuário Teste\",\n  \"email\": \"teste@example.com\",\n  \"password\": \"senha123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Cria um novo usuário e retorna os dados dele com o token JWT."
					},
					"response": []
				},
				{
					"name": "Login de Usuário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.token) {",
									"    pm.collectionVariables.set(\"token\", response.token);",
									"    console.log(\"Token JWT salvo nas variáveis da coleção!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"teste@example.com\",\n  \"password\": \"senha123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"login"
							]
						},
						"description": "Autentica um usuário existente e salva o token JWT automaticamente nas variáveis da coleção."
					},
					"response": []
				}
			]
		},
		{
			"name": "Consultas",
			"item": [
				{
					"name": "Realizar Consulta (Endereço ou Dúvida)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"Rua Humaitá, 500, Londrina\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/query",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"query"
							]
						},
						"description": "Envia um endereço para consulta de zoneamento urbano ou uma dúvida geral sobre leis urbanísticas."
					},
					"response": []
				},
				{
					"name": "Consultar Histórico",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/query/history",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"query",
								"history"
							]
						},
						"description": "Busca todo o histórico de consultas do usuário autenticado."
					},
					"response": []
				},
				{
					"name": "Deletar Consulta do Histórico",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/query/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"query",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "ID_DA_CONSULTA_AQUI",
									"description": "ID da consulta retornada no histórico ou na resposta da própria consulta"
								}
							]
						},
						"description": "Remove uma consulta do histórico do usuário pelo ID da mesma."
					},
					"response": []
				}
			],
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{token}}",
						"type": "string"
					}
				]
			}
		}
